# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres (get both from Supabase project settings -> Database -> Connection string)
# DATABASE_URL is the pooled connection (port 6543) used by the running app.
# DIRECT_URL is the direct connection (port 5432) used by Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# AWS Bedrock — used for all Claude calls (investigator + auditor)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1

# Bedrock model ID. Falls back to default if unset.
# Set AWS_BEDROCK_INVESTIGATOR_MODEL_ID and AWS_BEDROCK_AUDITOR_MODEL_ID
# separately if you want different models for each role.
AWS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: GitHub token for higher clone rate limits on public repos.
# Not required — public clones work without it.
GITHUB_TOKEN=
