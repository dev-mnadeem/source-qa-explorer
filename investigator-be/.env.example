# ---------------------------------------------------------------------------
# Copy to .env. Every value here has a working default — the app boots and a
# full investigation runs with this file left exactly as it is.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Postgres. Matches docker-compose (note port 5433 on the host).
DATABASE_URL=postgresql://investigator:investigator@localhost:5433/investigator
DIRECT_URL=postgresql://investigator:investigator@localhost:5433/investigator

# --- LLM -------------------------------------------------------------------
# Leave the AWS values blank to run the offline provider: the agent still
# lists, searches and reads the repository, and its citations are verified
# against the real source. Fill them in for live model answers.
#
# Force a provider regardless of credentials with: fake | bedrock
LLM_PROVIDER=

# Artificial latency per offline model call, in milliseconds. Offline calls are
# instant, which makes the live progress stream flash past unread; ~600 gives a
# demo the pacing of a real investigation. Leave at 0 for tests and CI.
FAKE_LLM_DELAY_MS=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional model overrides.
# AWS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_BEDROCK_INVESTIGATOR_MODEL_ID=
# AWS_BEDROCK_AUDITOR_MODEL_ID=

# Cost estimation, USD per million tokens. Vendor pricing changes; override
# here rather than in code.
# LLM_PRICE_INPUT_PER_MTOK=3.0
# LLM_PRICE_OUTPUT_PER_MTOK=15.0
